{
    "name": "daika7ana/fancourier-api",
    "description": "Internal fork: Library for FanCourier API v2.0",
    "type": "library",
    "authors": [
        {
            "name": "Shu Saura",
            "role": "Developer"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^2",
        "laravel/pint": "^1"
    },
    "autoload": {
        "psr-4": {
            "Fancourier\\": "src/Fancourier/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fancourier\\Tests\\": "tests/"
        }
    }
}
